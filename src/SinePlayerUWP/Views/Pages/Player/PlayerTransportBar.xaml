<base:BaseUserControl
    x:Class="SinePlayerUWP.Views.Pages.Player.PlayerTransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayerUWP.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Button.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel
        x:Name="BottomGrid"
        VerticalAlignment="Bottom"
        Orientation="Vertical">
        <Rectangle Height="1" Fill="{ThemeResource SidePaneBorderBrush}" />
        <StackPanel
            Padding="8,0,8,12"
            Background="{ThemeResource TitleBarBackground}"
            Orientation="Vertical">
            <Slider
                x:Name="SeekSlider"
                Margin="4,0"
                IsEnabled="False"
                IsThumbToolTipEnabled="False"
                Maximum="1"
                StepFrequency="1"
                ValueChanged="OnSeekValueChanged" />
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="AbbPrevious"
                        Click="OnPreviousClick"
                        IsEnabled="False"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Previous}">
                        <Button.Content>
                            <FontIcon FontSize="14" Glyph="&#xE892;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AbbPlayPause"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Play}">
                        <Button.Content>
                            <FontIcon x:Name="FiPlayPause" FontSize="14" Glyph="&#xE768;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AbbNext"
                        Click="OnNextClick"
                        IsEnabled="False"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Next}">
                        <Button.Content>
                            <FontIcon FontSize="14" Glyph="&#xE893;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AbbPlaylist"
                        Click="OnPlaylistClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.ReadingList}">
                        <Button.Content>
                            <FontIcon FontSize="16" Glyph="&#xE7BC;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AbbMore"
                        Click="OnMoreClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.More}">
                        <Button.Content>
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button.Content>
                    </Button>
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="AbbMute"
                        Click="OnMuteClick"
                        Style="{StaticResource PlaybackControlButtonStyle}">
                        <Button.Content>
                            <FontIcon x:Name="FiMute" FontSize="14" Glyph="&#xE767;" />
                        </Button.Content>
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        Width="80"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        StepFrequency="0.01"
                        Value="1"
                        ValueChanged="OnVolumeValueChanged" />
                    <TextBlock
                        x:Name="TbPosition"
                        Margin="0,0,2,2"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="0:00 / 0:00" />
                    <TextBlock
                        x:Name="TbPositionSecondary"
                        Margin="0,0,12,2"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource ForegroundGrey2}"
                        Text="0%" />
                    <Button
                        x:Name="AbbPin"
                        Click="OnPinClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Pin}">
                        <Button.Content>
                            <FontIcon x:Name="FiPin" FontSize="14" Glyph="&#xE718;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AbbFullscreen"
                        Click="OnFullscreenClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.EnterFullscreen}">
                        <Button.Content>
                            <FontIcon x:Name="FiFullscreen" FontSize="14" Glyph="&#xE740;" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</base:BaseUserControl>
