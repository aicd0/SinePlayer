<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>x64;ARM64</Platforms>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU1903</WarningsNotAsErrors>
	</PropertyGroup>

	<Target Name="CopyNativeMethods" BeforeTargets="BeforeBuild">
		<Copy SourceFiles="NativeMethods.$(Platform).txt" DestinationFiles="NativeMethods.txt" />
	</Target>
	<ItemGroup>
		<AdditionalFiles Include="NativeMethods.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.264">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
		<PackageReference Include="Sentry" Version="6.0.0" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.1" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.1" />
		<PackageReference Include="System.Management" Version="10.0.1" />
	</ItemGroup>

	<PropertyGroup>
		<NativeRid Condition="'$(Platform)' == 'x64'">win-x64</NativeRid>
		<NativeRid Condition="'$(Platform)' == 'ARM64'">win-arm64</NativeRid>
	</PropertyGroup>

	<ItemGroup>
		<None Include="native\$(NativeRid)\*.dll">
			<Link>runtimes\$(NativeRid)\native\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SinePlayer.SDK\SinePlayer.SDK.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SinePlayer.Core.Tests" />
	</ItemGroup>

</Project>
