<base:BaseUserControl
    x:Class="SinePlayer.UserControls.PlayerSettings.PlayerSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <SelectorBar
            x:Name="SettingsTabSelectorBar"
            Margin="14,0"
            Padding="0,12,0,8"
            SelectionChanged="SelectorBar_SelectionChanged">
            <SelectorBarItem
                x:Name="SelectorBarItem1"
                Padding="12,0,12,4"
                Text="{x:Bind ViewModel.VideoTabTitle, Mode=OneWay}" />
            <SelectorBarItem
                x:Name="SelectorBarItem2"
                Padding="12,0,12,4"
                Text="{x:Bind ViewModel.AudioTabTitle, Mode=OneWay}" />
        </SelectorBar>
        <Rectangle Height="1" Fill="{ThemeResource MediaInfoSeparatorForeground}" />

        <!--  Video tab  -->
        <StackPanel
            x:Name="VideoSettingsGrid"
            MinWidth="360"
            Orientation="Vertical" />

        <!--  Audio tab  -->
        <StackPanel
            x:Name="AudioSettingsGrid"
            MinWidth="360"
            Orientation="Vertical"
            Visibility="Collapsed" />

        <Rectangle
            Height="1"
            Margin="0,0,0,12"
            Fill="{ThemeResource MediaInfoSeparatorForeground}" />

        <Grid Margin="14,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Click="ResetButton_Click"
                Content="{x:Bind StringResource.Reset}" />
            <DropDownButton
                x:Name="PresetDropDownButton"
                Grid.Column="2"
                Margin="5,0,0,0" />
            <Button
                Grid.Column="3"
                Width="32"
                Margin="5,0,0,0"
                Padding="0"
                VerticalAlignment="Stretch"
                Click="EditPresetButton_Click"
                ToolTipService.ToolTip="{x:Bind StringResource.Edit}">
                <FontIcon FontSize="16" Glyph="&#xE70F;" />
            </Button>
        </Grid>

    </StackPanel>

</base:BaseUserControl>
