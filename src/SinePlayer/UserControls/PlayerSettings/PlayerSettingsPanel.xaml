<?xml version="1.0" encoding="utf-8" ?>
<base:BaseUserControl
    x:Class="SinePlayer.UserControls.PlayerSettings.PlayerSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:SinePlayer.UserControls.PlayerSettings"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ToggleSwitch.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CommonSettingRowStyle" TargetType="Grid">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <Style x:Key="TallSettingRowStyle" TargetType="Grid">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="14,0" />
            </Style>
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <SelectorBar
                x:Name="SettingsTabSelectorBar"
                Margin="14,0"
                Padding="0,12,0,8"
                SelectionChanged="SelectorBar_SelectionChanged">
                <SelectorBarItem
                    x:Name="SelectorBarItemGeneral"
                    Padding="12,0,12,4"
                    Text="{x:Bind ViewModel.GeneralTabTitle, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="SelectorBarItemVideo"
                    Padding="12,0,12,4"
                    Text="{x:Bind ViewModel.VideoTabTitle, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="SelectorBarItemAudio"
                    Padding="12,0,12,4"
                    Text="{x:Bind ViewModel.AudioTabTitle, Mode=OneWay}" />
                <SelectorBarItem
                    x:Name="SelectorBarItemSubtitle"
                    Padding="12,0,12,4"
                    Text="{x:Bind ViewModel.SubtitleTabTitle, Mode=OneWay}" />
            </SelectorBar>
            <StackPanel
                x:Name="TrackScopeRow"
                Margin="0,0,0,8"
                Orientation="Vertical">
                <Rectangle
                    Height="1"
                    Margin="0,0,0,8"
                    Fill="{ThemeResource MediaInfoSeparatorForeground}" />
                <Grid Style="{StaticResource TallSettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        VerticalAlignment="Center"
                        Text="{x:Bind StringResource.Track}" />
                    <ComboBox
                        x:Name="TrackScopeComboBox"
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        SelectionChanged="ScopeComboBox_SelectionChanged" />
                </Grid>
            </StackPanel>
            <Rectangle Height="1" Fill="{ThemeResource MediaInfoSeparatorForeground}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            MaxHeight="400"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid MinWidth="360">
                <StackPanel
                    x:Name="GeneralSettingsGrid"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Playback}" SectionKey="Playback">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.GeneralSpeedLabel, Mode=OneWay}" />
                                    <NumberBox
                                        x:Name="GeneralSpeedNumberBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        LargeChange="0.5"
                                        Maximum="8"
                                        Minimum="0.1"
                                        SmallChange="0.1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="GeneralSpeedNumberBox_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                </StackPanel>

                <StackPanel x:Name="VideoSettingsGrid" Orientation="Vertical">
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Output}" SectionKey="Output">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoDecoderLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="VideoDecoderDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoRendererLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="VideoRendererDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Rectangle
                                    Height="1"
                                    Margin="0,8"
                                    Fill="{ThemeResource MediaInfoSeparatorForeground}" />
                                <Grid Style="{StaticResource CommonSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoPreferHardwareDecodingLabel, Mode=OneWay}" />
                                    <ToggleSwitch
                                        x:Name="VideoPreferHardwareDecodingToggleSwitch"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CompatToggleSwitchStyle}"
                                        Toggled="VideoPreferHardwareDecodingToggleSwitch_Toggled" />
                                </Grid>
                                <Grid Style="{StaticResource CommonSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoPreferHdrLabel, Mode=OneWay}" />
                                    <ToggleSwitch
                                        x:Name="VideoPreferHdrToggleSwitch"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CompatToggleSwitchStyle}"
                                        Toggled="VideoPreferHdrToggleSwitch_Toggled" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Transform}" SectionKey="Transform">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoStretchModeLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="VideoStretchModeDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoRotationLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="VideoRotationDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Rectangle
                                    Height="1"
                                    Margin="0,8"
                                    Fill="{ThemeResource MediaInfoSeparatorForeground}" />
                                <Grid Style="{StaticResource CommonSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoFlipHorizontalLabel, Mode=OneWay}" />
                                    <ToggleSwitch
                                        x:Name="VideoFlipHorizontalToggleSwitch"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CompatToggleSwitchStyle}"
                                        Toggled="VideoFlipHorizontalToggleSwitch_Toggled" />
                                </Grid>
                                <Grid Style="{StaticResource CommonSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoFlipVerticalLabel, Mode=OneWay}" />
                                    <ToggleSwitch
                                        x:Name="VideoFlipVerticalToggleSwitch"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CompatToggleSwitchStyle}"
                                        Toggled="VideoFlipVerticalToggleSwitch_Toggled" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Image}" SectionKey="Image">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.VideoInterpolationLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="VideoInterpolationDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                </StackPanel>

                <StackPanel
                    x:Name="AudioSettingsGrid"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Output}" SectionKey="Output">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.AudioDecoderLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="AudioDecoderDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.AudioRendererLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="AudioRendererDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                </StackPanel>

                <StackPanel
                    x:Name="SubtitleSettingsGrid"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Output}" SectionKey="Output">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleDecoderLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="SubtitleDecoderDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleRendererLabel, Mode=OneWay}" />
                                    <DropDownButton
                                        x:Name="SubtitleRendererDropDownButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleOrderLabel, Mode=OneWay}" />
                                    <NumberBox
                                        x:Name="SubtitleOrderNumberBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        LargeChange="10"
                                        Maximum="100"
                                        Minimum="-100"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="SubtitleOrderNumberBox_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Font}" SectionKey="Font">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleFontFamilyLabel, Mode=OneWay}" />
                                    <ComboBox
                                        x:Name="SubtitleFontFamilyComboBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="SubtitleFontFamilyComboBox_SelectionChanged" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleFontSizeLabel, Mode=OneWay}" />
                                    <ComboBox
                                        x:Name="SubtitleFontSizeComboBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsEditable="True"
                                        SelectionChanged="SubtitleFontSizeComboBox_SelectionChanged"
                                        TextSubmitted="SubtitleFontSizeComboBox_TextSubmitted" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleFontStyleLabel, Mode=OneWay}" />
                                    <ComboBox
                                        x:Name="SubtitleFontStyleComboBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="SubtitleFontStyleComboBox_SelectionChanged" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleFontWeightLabel, Mode=OneWay}" />
                                    <ComboBox
                                        x:Name="SubtitleFontWeightComboBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="SubtitleFontWeightComboBox_SelectionChanged" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleFontColorLabel, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="3"
                                        Height="32"
                                        Padding="4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <Border
                                            x:Name="SubtitleFontColorPreview"
                                            Width="36"
                                            Height="20"
                                            CornerRadius="2" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    x:Name="SubtitleFontColorPicker"
                                                    ColorChanged="SubtitleFontColorPicker_ColorChanged"
                                                    IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleOutlineWidthLabel, Mode=OneWay}" />
                                    <NumberBox
                                        x:Name="SubtitleOutlineWidthNumberBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        LargeChange="1"
                                        Maximum="10"
                                        Minimum="0"
                                        SmallChange="0.1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="SubtitleOutlineWidthNumberBox_ValueChanged" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitleOutlineColorLabel, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="3"
                                        Padding="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <Border
                                            x:Name="SubtitleOutlineColorPreview"
                                            Width="36"
                                            Height="20"
                                            CornerRadius="2" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    x:Name="SubtitleOutlineColorPicker"
                                                    ColorChanged="SubtitleOutlineColorPicker_ColorChanged"
                                                    IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <Rectangle
                                    Height="1"
                                    Margin="0,8"
                                    Fill="{ThemeResource MediaInfoSeparatorForeground}" />
                                <settings:SliderSettingView
                                    x:Name="SubtitleOpacitySlider"
                                    DefaultValue="100"
                                    Label="{x:Bind ViewModel.SubtitleOpacityLabel, Mode=OneWay}"
                                    Maximum="100"
                                    Minimum="0"
                                    StepFrequency="1"
                                    ValueChanged="SubtitleOpacitySlider_ValueChanged" />
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                    <settings:PlayerSettingsSection Title="{x:Bind StringResource.Transform}" SectionKey="Transform">
                        <settings:PlayerSettingsSection.SectionContent>
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitlePanXLabel, Mode=OneWay}" />
                                    <NumberBox
                                        x:Name="SubtitlePanXNumberBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        LargeChange="20"
                                        Maximum="2000"
                                        Minimum="-2000"
                                        SmallChange="5"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="SubtitlePanXNumberBox_ValueChanged" />
                                </Grid>
                                <Grid Style="{StaticResource TallSettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.SubtitlePanYLabel, Mode=OneWay}" />
                                    <NumberBox
                                        x:Name="SubtitlePanYNumberBox"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        LargeChange="20"
                                        Maximum="2000"
                                        Minimum="-2000"
                                        SmallChange="5"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="SubtitlePanYNumberBox_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </settings:PlayerSettingsSection.SectionContent>
                    </settings:PlayerSettingsSection>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Rectangle Height="1" Fill="{ThemeResource MediaInfoSeparatorForeground}" />
            <Grid Margin="14,12,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Click="ResetButton_Click"
                    Content="{x:Bind StringResource.Reset}" />
                <DropDownButton
                    x:Name="PresetDropDownButton"
                    Grid.Column="2"
                    Margin="5,0,0,0" />
                <Button
                    Grid.Column="3"
                    Width="32"
                    Margin="5,0,0,0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Click="EditPresetButton_Click"
                    ToolTipService.ToolTip="{x:Bind StringResource.Edit}">
                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                </Button>
            </Grid>
        </StackPanel>

    </Grid>

</base:BaseUserControl>
