<base:BaseUserControl
    x:Class="SinePlayer.UserControls.PlayerSettings.NumberBoxSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:SinePlayer.UserControls.PlayerSettings"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <settings:SettingEntryView x:Name="Entry" RowHeight="40">
        <settings:SettingEntryView.Editor>
            <NumberBox
                x:Name="MainNumberBox"
                SpinButtonPlacementMode="Inline"
                ValueChanged="MainNumberBox_ValueChanged" />
        </settings:SettingEntryView.Editor>
    </settings:SettingEntryView>

</base:BaseUserControl>