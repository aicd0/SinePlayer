<base:BaseUserControl
    x:Class="SinePlayer.UserControls.MediaItemView.MediaItemLargeLandscape"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:controls="using:SinePlayer.UserControls.Misc"
    xmlns:converters="using:SinePlayer.Converters"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwm="using:CommunityToolkit.WinUI.Media"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrols="using:SinePlayer.UserControls.Misc"
    xmlns:vm="using:SinePlayer.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MediaItemViewModel}"
    Tapped="BaseUserControl_Tapped"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ButtonBackground}"
        ContextRequested="RootGrid_ContextRequested"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerPressed="RootGrid_PointerPressed"
        Tapped="RootGrid_Tapped">
        <Grid.BackgroundTransition>
            <BrushTransition Duration="0:0:0.083" />
        </Grid.BackgroundTransition>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="80" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,16,12,0">
                <Grid Height="120">
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="4">
                        <usercontrols:SimpleImageView x:Name="ImageHolder" ImageUri="{x:Bind Item.CoverImageUri, Mode=OneWay}" />
                    </Border>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="48"
                        Foreground="{ThemeResource ForegroundGrey2}"
                        Glyph="{x:Bind Item.CoverPlaceholderGlyph, Mode=OneWay}"
                        Visibility="{x:Bind Item.IsCoverImageVisible, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}" />
                </Grid>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Margin="10,0,10,10"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="3">
                <StackPanel
                    HorizontalAlignment="Left"
                    Opacity="0.6"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind Item.IsCollection, Mode=OneWay}">
                    <FontIcon
                        Margin="0,1,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xF5ED;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind StringResource.Collection}" />
                </StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="14"
                    FontWeight="SemiBold"
                    MaxLines="{x:Bind GetTitleMaxLines(Item.IsCollection, Item.IsRatingVisible), Mode=OneWay}"
                    Text="{x:Bind Item.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="{x:Bind Item.Title, Mode=OneWay}" />
                <StackPanel
                    HorizontalAlignment="Left"
                    Opacity="0.6"
                    Orientation="Horizontal"
                    Visibility="{x:Bind Item.IsRatingVisible, Mode=OneWay}">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind Item.Rating, Mode=OneWay}" />
                    <FontIcon
                        Margin="4,1,0,0"
                        FontSize="9"
                        Glyph="&#xE735;" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiLight"
                    Opacity="0.6"
                    Text="{x:Bind Item.DurationAndProgress, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackground}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</base:BaseUserControl>
