<base:BasePage
    x:Class="SinePlayer.Views.Pages.PlaybackLab.PlaybackLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="12"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="OpenButton"
                Click="OpenButton_Click"
                Content="Open image or video" />
            <Button
                x:Name="PlayButton"
                Click="PlayButton_Click"
                Content="Play" />
            <Button
                x:Name="PauseButton"
                Click="PauseButton_Click"
                Content="Pause" />
            <Button
                x:Name="SeekBackButton"
                Click="SeekBackButton_Click"
                Content="-10s" />
            <Button
                x:Name="SeekForwardButton"
                Click="SeekForwardButton_Click"
                Content="+30s" />
            <Slider
                x:Name="VolumeSlider"
                Width="200"
                Maximum="100"
                Minimum="0"
                ValueChanged="VolumeSlider_ValueChanged"
                Value="100" />
            <ToggleButton
                x:Name="MuteToggle"
                VerticalAlignment="Bottom"
                Click="MuteToggle_Click"
                Content="Mute" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="12,0,12,12"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                x:Name="VideoDecoderPicker"
                Header="Video decoder"
                SelectionChanged="VideoDecoderPicker_SelectionChanged" />
            <ComboBox
                x:Name="AudioDecoderPicker"
                Header="Audio decoder"
                SelectionChanged="AudioDecoderPicker_SelectionChanged" />
            <ComboBox
                x:Name="VideoRendererPicker"
                Header="Video renderer"
                SelectionChanged="VideoRendererPicker_SelectionChanged" />
            <ComboBox
                x:Name="AudioRendererPicker"
                Header="Audio renderer"
                SelectionChanged="AudioRendererPicker_SelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="2" Background="Black">
            <SwapChainPanel x:Name="VideoPanel" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Margin="12"
            IsTextSelectionEnabled="True"
            Text="Pick a file to play it through the engine: FFmpeg decodes, Direct3D 11 presents and WASAPI plays the sound."
            TextWrapping="Wrap" />
    </Grid>
</base:BasePage>
