<base:BasePage
    x:Class="SinePlayer.Views.Pages.PlaybackLab.PlaybackLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="12"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="OpenButton"
                Click="OnOpenClicked"
                Content="Open image or video" />
            <Button
                x:Name="PlayButton"
                Click="OnPlayClicked"
                Content="Play"
                IsEnabled="False" />
            <Button
                x:Name="PauseButton"
                Click="OnPauseClicked"
                Content="Pause"
                IsEnabled="False" />
            <Button
                x:Name="SeekBackButton"
                Click="OnSeekBackClicked"
                Content="-10s"
                IsEnabled="False" />
            <Button
                x:Name="SeekForwardButton"
                Click="OnSeekForwardClicked"
                Content="+30s"
                IsEnabled="False" />
        </StackPanel>

        <Grid Grid.Row="1" Background="Black">
            <SwapChainPanel x:Name="VideoPanel" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="12"
            IsTextSelectionEnabled="True"
            Text="Pick a file to play it through the engine: FFmpeg decodes, Direct3D 11 presents and WASAPI plays the sound."
            TextWrapping="Wrap" />
    </Grid>
</base:BasePage>
