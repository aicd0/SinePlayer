<base:BasePage
    x:Class="SinePlayer.Views.Pages.PlaybackLab.PlaybackLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="12"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="OpenButton"
                Click="OpenButton_Click"
                Content="Open image or video" />
            <Button
                x:Name="PlayButton"
                Click="PlayButton_Click"
                Content="Play" />
            <Button
                x:Name="PauseButton"
                Click="PauseButton_Click"
                Content="Pause" />
            <Button
                x:Name="SeekBackButton"
                Click="SeekBackButton_Click"
                Content="-10s" />
            <Button
                x:Name="SeekForwardButton"
                Click="SeekForwardButton_Click"
                Content="+30s" />
            <Slider
                x:Name="VolumeSlider"
                Width="200"
                Maximum="100"
                Minimum="0"
                ValueChanged="VolumeSlider_ValueChanged"
                Value="100" />
            <ToggleButton
                x:Name="MuteToggle"
                VerticalAlignment="Bottom"
                Click="MuteToggle_Click"
                Content="Mute" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="12,0,12,12"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                x:Name="VideoDecoderPicker"
                Header="Video decoder"
                SelectionChanged="VideoDecoderPicker_SelectionChanged" />
            <ComboBox
                x:Name="VideoRendererPicker"
                Header="Video renderer"
                SelectionChanged="VideoRendererPicker_SelectionChanged" />
            <ComboBox
                x:Name="AudioDecoderPicker"
                Header="Audio decoder"
                SelectionChanged="AudioDecoderPicker_SelectionChanged" />
            <ComboBox
                x:Name="AudioRendererPicker"
                Header="Audio renderer"
                SelectionChanged="AudioRendererPicker_SelectionChanged" />
            <ComboBox
                x:Name="SubtitleDecoderPicker"
                Header="Subtitle decoder"
                SelectionChanged="SubtitleDecoderPicker_SelectionChanged" />
            <ComboBox
                x:Name="SubtitleRendererPicker"
                Header="Subtitle renderer"
                SelectionChanged="SubtitleRendererPicker_SelectionChanged" />
            <ComboBox
                x:Name="VideoTrackPicker"
                Header="Video track"
                SelectionChanged="VideoTrackPicker_SelectionChanged" />
            <ComboBox
                x:Name="AudioTrackPicker"
                Header="Audio track"
                SelectionChanged="AudioTrackPicker_SelectionChanged" />
            <ComboBox
                x:Name="SubtitleTrackPicker"
                Header="Subtitle track"
                SelectionChanged="SubtitleTrackPicker_SelectionChanged" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="12,0,12,12"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox x:Name="RotationPicker" SelectionChanged="TransformChoice_SelectionChanged" />
            <ToggleButton
                x:Name="FlipHorizontalToggle"
                VerticalAlignment="Bottom"
                Click="TransformToggle_Click"
                Content="Flip horizontal" />
            <ToggleButton
                x:Name="FlipVerticalToggle"
                VerticalAlignment="Bottom"
                Click="TransformToggle_Click"
                Content="Flip vertical" />
            <ComboBox x:Name="FittingPicker" SelectionChanged="TransformChoice_SelectionChanged" />
            <StackPanel
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock VerticalAlignment="Center" Text="Zoom" />
                <Slider
                    x:Name="ZoomSlider"
                    Width="110"
                    Maximum="400"
                    Minimum="50"
                    ValueChanged="TransformSlider_ValueChanged"
                    Value="100" />
            </StackPanel>
            <StackPanel
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock VerticalAlignment="Center" Text="Pan X" />
                <Slider
                    x:Name="PanXSlider"
                    Width="110"
                    Maximum="100"
                    Minimum="-100"
                    ValueChanged="TransformSlider_ValueChanged"
                    Value="0" />
            </StackPanel>
            <StackPanel
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock VerticalAlignment="Center" Text="Pan Y" />
                <Slider
                    x:Name="PanYSlider"
                    Width="110"
                    Maximum="100"
                    Minimum="-100"
                    ValueChanged="TransformSlider_ValueChanged"
                    Value="0" />
            </StackPanel>
            <Button
                x:Name="ResetTransformButton"
                VerticalAlignment="Bottom"
                Click="ResetTransformButton_Click"
                Content="Reset transform" />
        </StackPanel>

        <Grid Grid.Row="3" Background="Black">
            <SwapChainPanel x:Name="VideoPanel" IsHitTestVisible="False" />
            <SwapChainPanel x:Name="SubtitlePanel" IsHitTestVisible="False" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Margin="12"
            IsTextSelectionEnabled="True"
            Text="Pick a file to play it through the engine: FFmpeg decodes, Direct3D 11 presents and WASAPI plays the sound."
            TextWrapping="Wrap" />
    </Grid>
</base:BasePage>
