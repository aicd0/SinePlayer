<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="SinePlayer.Views.Pages.Player.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:player="using:SinePlayer.Views.Pages.Player"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Black">
        <Grid
            x:Name="VideoHost"
            ContextRequested="VideoHost_ContextRequested"
            PointerCanceled="VideoHost_PointerCanceled"
            PointerEntered="VideoHost_PointerEntered"
            PointerExited="VideoHost_PointerExited"
            PointerMoved="VideoHost_PointerMoved"
            PointerPressed="VideoHost_PointerPressed"
            PointerReleased="VideoHost_PointerReleased" />
        <Grid x:Name="SubtitleHost" IsHitTestVisible="False" />
        <player:PlayerTransportBar x:Name="TransportBar" VerticalAlignment="Bottom" />
        <TextBlock
            x:Name="PromptText"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="16"
            FontWeight="Bold"
            Foreground="Yellow"
            IsHitTestVisible="False"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>

</base:BasePage>
