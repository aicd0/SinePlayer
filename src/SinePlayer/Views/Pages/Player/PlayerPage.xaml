<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="SinePlayer.Views.Pages.Player.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:player="using:SinePlayer.Views.Pages.Player"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid>
        <Grid
            x:Name="VideoGrid"
            AllowDrop="True"
            Background="Black"
            ContextRequested="VideoGrid_ContextRequested"
            Drop="VideoGrid_Drop"
            PointerCanceled="VideoGrid_PointerCanceled"
            PointerCaptureLost="VideoGrid_PointerCaptureLost"
            PointerEntered="VideoGrid_PointerEntered"
            PointerExited="VideoGrid_PointerExited"
            PointerMoved="VideoGrid_PointerMoved"
            PointerPressed="VideoGrid_PointerPressed"
            PointerReleased="VideoGrid_PointerReleased"
            PointerWheelChanged="VideoGrid_PointerWheelChanged">
            <Grid x:Name="VideoHost" IsHitTestVisible="False" />
            <Grid x:Name="SubtitleHost" IsHitTestVisible="False" />
        </Grid>
        <FontIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="96"
            Glyph="&#xE8D6;"
            IsHitTestVisible="False"
            Opacity="0.6"
            Visibility="{x:Bind ViewModel.IsAudio, Mode=OneWay}" />
        <player:PlayerTransportBar x:Name="TransportBar" VerticalAlignment="Bottom" />
        <player:PlayerGestureHint
            x:Name="GestureHint"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        <Border
            x:Name="PromptBox"
            Padding="8,3,8,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#80000000"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="PromptText"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                TextWrapping="Wrap" />
        </Border>
    </Grid>

</base:BasePage>
