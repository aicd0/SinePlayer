<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="SinePlayer.Views.Pages.Player.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:player="using:SinePlayer.Views.Pages.Player"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Black">
        <Grid
            x:Name="VideoHost"
            ContextRequested="VideoHost_ContextRequested"
            PointerCanceled="VideoHost_PointerCanceled"
            PointerEntered="VideoHost_PointerEntered"
            PointerExited="VideoHost_PointerExited"
            PointerMoved="VideoHost_PointerMoved"
            PointerPressed="VideoHost_PointerPressed"
            PointerReleased="VideoHost_PointerReleased" />
        <StackPanel
            x:Name="StatusPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <ProgressRing
                x:Name="BusyRing"
                Width="36"
                Height="36"
                IsActive="True" />
            <TextBlock
                x:Name="StatusText"
                MaxWidth="480"
                Foreground="White"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <player:PlayerTransportBar x:Name="TransportBar" VerticalAlignment="Bottom" />
    </Grid>
</base:BasePage>
