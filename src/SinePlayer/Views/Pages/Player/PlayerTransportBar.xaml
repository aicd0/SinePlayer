<base:BaseUserControl
    x:Class="SinePlayer.Views.Pages.Player.PlayerTransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hotkey="using:SinePlayer.Common.HotKey"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Button.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel
        x:Name="BottomPanel"
        VerticalAlignment="Bottom"
        Orientation="Vertical">
        <Rectangle Height="1" Fill="{ThemeResource SidePaneBorderBrush}" />
        <StackPanel
            Padding="8,0,8,12"
            Background="{ThemeResource TitleBarBackground}"
            Orientation="Vertical">
            <Slider
                x:Name="SeekSlider"
                Margin="4,0"
                IsEnabled="False"
                IsThumbToolTipEnabled="False"
                Maximum="1"
                StepFrequency="1"
                ValueChanged="OnSeekValueChanged" />
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="PreviousButton"
                        hotkey:ShortcutToolTip.Action="OpenPreviousItem"
                        hotkey:ShortcutToolTip.Text="{x:Bind StringResource.Previous}"
                        Click="OnPreviousClick"
                        IsEnabled="False"
                        Style="{StaticResource PlaybackControlButtonStyle}">
                        <Button.Content>
                            <FontIcon FontSize="14" Glyph="&#xE892;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        hotkey:ShortcutToolTip.Action="PlayPause"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource PlaybackControlButtonStyle}">
                        <Button.Content>
                            <FontIcon x:Name="PlayPauseIcon" FontSize="14" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="NextButton"
                        hotkey:ShortcutToolTip.Action="OpenNextItem"
                        hotkey:ShortcutToolTip.Text="{x:Bind StringResource.Next}"
                        Click="OnNextClick"
                        IsEnabled="False"
                        Style="{StaticResource PlaybackControlButtonStyle}">
                        <Button.Content>
                            <FontIcon FontSize="14" Glyph="&#xE893;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="PlayQueueButton"
                        Click="OnPlayQueueClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.PlayQueue}">
                        <Button.Content>
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="RepeatButton"
                        Click="OnRepeatClick"
                        Style="{StaticResource PlaybackControlButtonStyle}">
                        <Button.Content>
                            <FontIcon x:Name="RepeatIcon" FontSize="14" />
                        </Button.Content>
                    </Button>
                    <ToggleButton
                        x:Name="ShuffleButton"
                        Click="OnShuffleClick"
                        Style="{StaticResource PlaybackControlToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Shuffle}">
                        <ToggleButton.Content>
                            <FontIcon
                                x:Name="ShuffleIcon"
                                FontSize="14"
                                Glyph="&#xE8B1;" />
                        </ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        x:Name="PositionTextBlock"
                        Margin="0,0,12,2"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="0:00 / 0:00" />
                    <Button
                        x:Name="VolumeButton"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Volume}">
                        <Button.Content>
                            <FontIcon
                                x:Name="VolumeIcon"
                                FontSize="14"
                                Glyph="&#xE995;" />
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="MuteButton"
                                        Click="OnMuteClick"
                                        Style="{StaticResource PlaybackControlButtonStyle}">
                                        <Button.Content>
                                            <FontIcon
                                                x:Name="MuteIcon"
                                                FontSize="16"
                                                Glyph="&#xE995;" />
                                        </Button.Content>
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        StepFrequency="1"
                                        ValueChanged="OnVolumeValueChanged"
                                        Value="100" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="PinButton"
                        Click="OnPinClick"
                        Style="{StaticResource PlaybackControlButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind StringResource.Pin}">
                        <Button.Content>
                            <FontIcon
                                x:Name="PinIcon"
                                FontSize="14"
                                Glyph="&#xE718;" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="FullscreenButton"
                        hotkey:ShortcutToolTip.Action="ToggleFullscreen"
                        hotkey:ShortcutToolTip.Text="{x:Bind StringResource.EnterFullscreen}"
                        Click="OnFullscreenClick"
                        Style="{StaticResource PlaybackControlButtonStyle}">
                        <Button.Content>
                            <FontIcon
                                x:Name="FullscreenIcon"
                                FontSize="14"
                                Glyph="&#xE740;" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</base:BaseUserControl>
