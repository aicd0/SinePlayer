<base:BaseUserControl
    x:Class="SinePlayer.Views.Pages.Player.PlayerGestureHint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="200"
    IsHitTestVisible="False"
    Visibility="Collapsed"
    mc:Ignorable="d">

    <Border
        MinWidth="120"
        Padding="24,16"
        Background="#A6000000"
        CornerRadius="8">
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <FontIcon
                x:Name="EffectIcon"
                VerticalAlignment="Center"
                FontSize="32"
                Foreground="White" />
            <TextBlock
                x:Name="EffectText"
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="White" />
        </StackPanel>
    </Border>
</base:BaseUserControl>
