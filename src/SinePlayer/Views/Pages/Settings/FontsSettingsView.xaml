<base:BaseUserControl
    x:Class="SinePlayer.Views.Pages.Settings.FontsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:converters="using:SinePlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

            <!--  Overwrite TreeViewItem style  -->
            <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent" />
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Click="ImportFontsButton_Click" Content="{x:Bind StringResource.ImportFonts}" />
            <Button Click="OpenFontsFolderButton_Click" Content="{x:Bind StringResource.OpenFontsFolder}" />
        </StackPanel>
        <TextBlock
            Margin="0,16,0,0"
            Text="{x:Bind StringResource.NoFontsImported}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.NoFonts, Mode=OneWay}" />
        <Border
            Margin="0,16,0,0"
            Padding="0,7,0,8"
            Background="{ThemeResource SettingsListViewBackground}"
            CornerRadius="4"
            Visibility="{x:Bind ViewModel.NoFonts, Mode=OneWay, Converter={StaticResource BooleanToVisibilityNegationConverter}}">
            <TreeView
                x:Name="FontsTreeView"
                SelectionChanged="FontsTreeView_SelectionChanged"
                SelectionMode="Multiple" />
        </Border>
    </StackPanel>

</base:BaseUserControl>