<base:BaseUserControl
    x:Class="SinePlayer.Views.Pages.Settings.PlayerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <CheckBox
            Click="RestoreLastPlaybackPositionCheckBox_Click"
            Content="{x:Bind StringResource.RestoreLastPlaybackPosition}"
            IsChecked="{x:Bind ViewModel.RestoreLastPlaybackPosition, Mode=TwoWay}" />
        <CheckBox
            Click="AutoToggleOverlaysOnCursorCheckBox_Click"
            Content="{x:Bind StringResource.AutoToggleOverlaysOnCursor}"
            IsChecked="{x:Bind ViewModel.AutoToggleOverlaysOnCursor, Mode=TwoWay}" />
        <CheckBox
            Click="AutoPlayNextCheckBox_Click"
            Content="{x:Bind StringResource.AutoPlayNext}"
            IsChecked="{x:Bind ViewModel.AutoPlayNext, Mode=TwoWay}" />
        <CheckBox
            Click="AutoPlayOnOpenCheckBox_Click"
            Content="{x:Bind StringResource.AutoPlayOnOpen}"
            IsChecked="{x:Bind ViewModel.AutoPlayOnOpen, Mode=TwoWay}" />
        <CheckBox
            Margin="16,0,0,0"
            Click="AutoPlayOnOpenExceptAppLaunchCheckBox_Click"
            Content="{x:Bind StringResource.ExceptAppLaunch}"
            IsChecked="{x:Bind ViewModel.AutoPlayOnOpenExceptAppLaunch, Mode=TwoWay}" />
        <CheckBox
            Click="PauseOnLeaveTabCheckBox_Click"
            Content="{x:Bind StringResource.PauseOnLeaveTab}"
            IsChecked="{x:Bind ViewModel.PauseOnLeaveTab, Mode=TwoWay}" />
        <CheckBox
            Click="PreciseSeekingCheckBox_Click"
            Content="{x:Bind StringResource.PreciseSeeking}"
            IsChecked="{x:Bind ViewModel.PreciseSeeking, Mode=TwoWay}" />
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.KeepScreenOn}"
                TextWrapping="Wrap" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="2"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.KeepScreenOnBehaviors, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.KeepScreenOnBehaviorIndex, Mode=TwoWay}"
                SelectionChanged="KeepScreenOnBehaviorComboBox_SelectionChanged" />
        </Grid>

        <Rectangle
            Height="1"
            Margin="0,16"
            Fill="{ThemeResource AppSeperator1}" />

        <Grid HorizontalAlignment="Left" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.SeekForward}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SeekForwardNumberBox"
                    MinWidth="120"
                    LargeChange="10"
                    Maximum="600"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SeekForwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SeekForwardSeconds, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>
            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.SeekBackward}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="0"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SeekBackwardNumberBox"
                    MinWidth="120"
                    LargeChange="10"
                    Maximum="600"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SeekBackwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SeekBackwardSeconds, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.VolumeUp}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="VolumeUpNumberBox"
                    MinWidth="120"
                    LargeChange="5"
                    Maximum="50"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="VolumeUpNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.VolumeUpPercent, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="%" />
            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.VolumeDown}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="1"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="VolumeDownNumberBox"
                    MinWidth="120"
                    LargeChange="5"
                    Maximum="50"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="VolumeDownNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.VolumeDownPercent, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="%" />
            </StackPanel>

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.ZoomIn}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="ZoomInNumberBox"
                    MinWidth="120"
                    LargeChange="0.1"
                    Maximum="1"
                    Minimum="0.01"
                    SmallChange="0.01"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="ZoomInNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.ZoomInStep, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock
                Grid.Row="2"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.ZoomOut}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="ZoomOutNumberBox"
                    MinWidth="120"
                    LargeChange="0.1"
                    Maximum="1"
                    Minimum="0.01"
                    SmallChange="0.01"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="ZoomOutNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.ZoomOutStep, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.FastForward}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="3"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="FastForwardNumberBox"
                    MinWidth="120"
                    LargeChange="0.5"
                    Maximum="8"
                    Minimum="1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="FastForwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.FastForwardSpeed, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="x" />
            </StackPanel>

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SyncVideoForwardLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="4"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SyncVideoForwardNumberBox"
                    MinWidth="120"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0.1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SyncVideoForwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SyncVideoForwardStep, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>
            <TextBlock
                Grid.Row="4"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SyncVideoBackwardLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="4"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SyncVideoBackwardNumberBox"
                    MinWidth="120"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0.1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SyncVideoBackwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SyncVideoBackwardStep, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>

            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SyncAudioForwardLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="5"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SyncAudioForwardNumberBox"
                    MinWidth="120"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0.1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SyncAudioForwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SyncAudioForwardStep, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>
            <TextBlock
                Grid.Row="5"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SyncAudioBackwardLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="5"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SyncAudioBackwardNumberBox"
                    MinWidth="120"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0.1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SyncAudioBackwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SyncAudioBackwardStep, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>

            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SyncSubtitleForwardLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="6"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SyncSubtitleForwardNumberBox"
                    MinWidth="120"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0.1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SyncSubtitleForwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SyncSubtitleForwardStep, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>
            <TextBlock
                Grid.Row="6"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SyncSubtitleBackwardLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="6"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SyncSubtitleBackwardNumberBox"
                    MinWidth="120"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0.1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SyncSubtitleBackwardNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SyncSubtitleBackwardStep, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="s" />
            </StackPanel>

            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.IncreaseFontSizeLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="7"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="IncreaseFontSizeNumberBox"
                    MinWidth="120"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="IncreaseSubtitleFontSizeNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.IncreaseSubtitleFontSizeStep, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock
                Grid.Row="7"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.DecreaseFontSizeLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="7"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="DecreaseFontSizeNumberBox"
                    MinWidth="120"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="DecreaseSubtitleFontSizeNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.DecreaseSubtitleFontSizeStep, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.VideoPanLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="8"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="VideoPanStepNumberBox"
                    MinWidth="120"
                    LargeChange="10"
                    Maximum="1000"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="VideoPanStepNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.VideoPanStep, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock
                Grid.Row="8"
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SubtitlePanLabel}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="8"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="SubtitlePanStepNumberBox"
                    MinWidth="120"
                    LargeChange="10"
                    Maximum="1000"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="SubtitlePanStepNumberBox_ValueChanged"
                    Value="{x:Bind ViewModel.SubtitlePanStep, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </StackPanel>

</base:BaseUserControl>
