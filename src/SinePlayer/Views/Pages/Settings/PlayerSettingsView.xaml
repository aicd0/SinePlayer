<base:BaseUserControl
    x:Class="SinePlayer.Views.Pages.Settings.PlayerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SinePlayer.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <CheckBox
            Click="RestoreLastPlaybackPositionCheckBox_Click"
            Content="{x:Bind StringResource.RestoreLastPlaybackPosition}"
            IsChecked="{x:Bind ViewModel.RestoreLastPlaybackPosition, Mode=TwoWay}" />
        <CheckBox
            Click="AutoToggleOverlaysOnCursorCheckBox_Click"
            Content="{x:Bind StringResource.AutoToggleOverlaysOnCursor}"
            IsChecked="{x:Bind ViewModel.AutoToggleOverlaysOnCursor, Mode=TwoWay}" />
        <CheckBox
            Click="AutoPlayNextCheckBox_Click"
            Content="{x:Bind StringResource.AutoPlayNext}"
            IsChecked="{x:Bind ViewModel.AutoPlayNext, Mode=TwoWay}" />
        <CheckBox
            Click="AutoPlayOnOpenCheckBox_Click"
            Content="{x:Bind StringResource.AutoPlayOnOpen}"
            IsChecked="{x:Bind ViewModel.AutoPlayOnOpen, Mode=TwoWay}" />
        <CheckBox
            Margin="16,0,0,0"
            Click="AutoPlayOnOpenExceptAppLaunchCheckBox_Click"
            Content="{x:Bind StringResource.ExceptAppLaunch}"
            IsChecked="{x:Bind ViewModel.AutoPlayOnOpenExceptAppLaunch, Mode=TwoWay}" />
        <CheckBox
            Click="PauseOnLeaveTabCheckBox_Click"
            Content="{x:Bind StringResource.PauseOnLeaveTab}"
            IsChecked="{x:Bind ViewModel.PauseOnLeaveTab, Mode=TwoWay}" />
        <CheckBox
            Click="PreciseSeekingCheckBox_Click"
            Content="{x:Bind StringResource.PreciseSeeking}"
            IsChecked="{x:Bind ViewModel.PreciseSeeking, Mode=TwoWay}" />
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.KeepScreenOn}"
                TextWrapping="Wrap" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="2"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.KeepScreenOnBehaviors, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.KeepScreenOnBehaviorIndex, Mode=TwoWay}"
                SelectionChanged="KeepScreenOnBehaviorComboBox_SelectionChanged" />
        </Grid>
    </StackPanel>

</base:BaseUserControl>
